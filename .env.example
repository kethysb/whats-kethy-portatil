# Configuração do Whats Kethy
PORT=3333
AUTH_DIR=.data/whatsapp-session-kethy

# Provedor de IA (Groq - Llama 3.3 70B / Qwen + Vision + Whisper)
AI_API_KEY=sua_chave_groq_aqui
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3.8-27b
AI_VISION_MODEL=openai/gpt-oss-120b
AI_AUDIO_MODEL=whisper-large-v3-turbo

# Resposta automática da IA (true para ligar, false para manual)
AUTO_REPLY=false

# Prompt do Agente
SYSTEM_PROMPT="Você é o assistente executivo pessoal da Kethely. Sua missão é ler as mensagens recebidas, identificar tarefas, pendências urgentes, promessas não cumpridas e montar um plano de ação claro."
